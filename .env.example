# Copy to .env.local for development. Never commit real values.
# Variables WITHOUT the NEXT_PUBLIC_ prefix stay on the server and are never sent to browsers.

# --- Tenant routing (Phase 0, in use now) ---
# Root domain that tenant subdomains hang off. "localhost" in dev, e.g. "yourplatform.com" in prod.
PLATFORM_ROOT_DOMAIN=localhost
# Tenant served on the bare root domain. Set in development only; leave empty in production.
DEFAULT_TENANT_SLUG=meridian

# --- Supabase (Phase 2, not used yet) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable/anon key. Safe in the browser ONLY because row-level security is enabled on every table.
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me
# Service role key bypasses row-level security. Server-only, for admin jobs. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace-me

# --- Secret encryption (Phase 3, not used yet) ---
# 32-byte key (base64) used to encrypt per-tenant integration secrets (e.g. VdoCipher API secret) at rest.
# Generate with: openssl rand -base64 32
INTEGRATION_SECRETS_KEY=replace-me

# --- Discord (Phase 5, not used yet) ---
# One platform-wide application and bot shared by all tenants.
DISCORD_APPLICATION_ID=replace-me
DISCORD_BOT_TOKEN=replace-me
DISCORD_PUBLIC_KEY=replace-me
